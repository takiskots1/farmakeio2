# Copy to .env and change every placeholder.
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql+psycopg://chryspharmacy:change-this@localhost:5432/chryspharmacy
COOKIE_SECURE=false

# Admin creation (used only by flask create-admin command)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-unique-password

# SMTP email (optional until configured)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=info@example.gr

# SMS.to integration placeholder (not active until provider-specific code is completed)
SMSTO_API_KEY=
